<script id="NEXORA_FINAL_WHATSAPP_VOICE">
(function(){
    if(window.__NEXORA_FINAL_WA__)return;
    window.__NEXORA_FINAL_WA__=true;

    const form=document.querySelector(
        'form.chat-form,form.chat-composer,form.message-form'
    );
    if(!form)return;

    /* Find the existing microphone control */
    let mic=null;

    form.querySelectorAll("button,label").forEach(function(el){
        const a=(el.getAttribute("aria-label")||"").toLowerCase();
        const t=(el.getAttribute("title")||"").toLowerCase();
        const x=(el.textContent||"").toLowerCase();

        if(
            a.includes("microphone") ||
            a.includes("voice") ||
            t.includes("microphone") ||
            t.includes("voice") ||
            x.includes("🎤") ||
            x.includes("mic")
        ){
            mic=el;
        }
    });

    if(!mic)return;

    const bar=document.createElement("div");
    bar.className="nexora-wa-recording";
    bar.innerHTML=`
        <button class="nexora-wa-cancel" type="button">×</button>
        <div class="nexora-wa-mic">🎙</div>
        <div class="nexora-wa-time">0:00</div>
        <div class="nexora-wa-wave">
          ${Array.from({length:45},()=>"<span></span>").join("")}
        </div>
        <button class="nexora-wa-send" type="button">➤</button>
    `;

    document.body.appendChild(bar);

    const cancel=bar.querySelector(".nexora-wa-cancel");
    const send=bar.querySelector(".nexora-wa-send");
    const time=bar.querySelector(".nexora-wa-time");

    let recorder=null;
    let stream=null;
    let chunks=[];
    let timer=null;
    let started=0;

    function cleanup(){
        clearInterval(timer);
        timer=null;
        if(stream){
            stream.getTracks().forEach(function(t){t.stop()});
            stream=null;
        }
        recorder=null;
        chunks=[];
        bar.classList.remove("active");
        time.textContent="0:00";
    }

    async function start(){
        try{
            stream=await navigator.mediaDevices.getUserMedia({audio:true});

            let type="audio/webm";
            if(!MediaRecorder.isTypeSupported(type)){
                type="";
            }

            recorder=type
                ?new MediaRecorder(stream,{mimeType:type})
                :new MediaRecorder(stream);

            chunks=[];

            recorder.ondataavailable=function(e){
                if(e.data&&e.data.size)chunks.push(e.data);
            };

            recorder.start();
            started=Date.now();
            bar.classList.add("active");

            timer=setInterval(function(){
                let sec=Math.floor((Date.now()-started)/1000);
                time.textContent=Math.floor(sec/60)+":"+
                    String(sec%60).padStart(2,"0");
            },250);

        }catch(e){
            alert("Please allow microphone access.");
        }
    }

    mic.addEventListener("click",function(e){
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        if(bar.classList.contains("active")){
            cleanup();
        }else{
            start();
        }
    },true);

    cancel.onclick=function(){
        if(recorder&&recorder.state!=="inactive"){
            try{recorder.stop()}catch(e){}
        }
        cleanup();
    };

    send.onclick=function(){
        if(!recorder||recorder.state==="inactive"){
            cleanup();
            return;
        }

        recorder.onstop=function(){
            if(!chunks.length){
                cleanup();
                return;
            }

            const blob=new Blob(
                chunks,
                {type:recorder.mimeType||"audio/webm"}
            );

            const file=new File(
                [blob],
                "voice_"+Date.now()+".webm",
                {type:blob.type}
            );

            const input=form.querySelector(
                'input[type="file"][name="media"]'
            );

            if(input){
                try{
                    const dt=new DataTransfer();
                    dt.items.add(file);
                    input.files=dt.files;
                    cleanup();

                    if(form.requestSubmit){
                        form.requestSubmit();
                    }else{
                        form.submit();
                    }
                    return;
                }catch(e){}
            }

            cleanup();
        };

        recorder.stop();
    };
})();
</script>
