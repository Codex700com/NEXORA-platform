<script id="NEXORA_WHATSAPP_VOICE">
(function(){
    if(window.__NEXORA_WHATSAPP_VOICE__) return;
    window.__NEXORA_WHATSAPP_VOICE__=true;

    const form=document.querySelector(
        "form.chat-form,form.chat-composer,form.message-form"
    );
    if(!form) return;

    const originalVoice=form.querySelector(
        '[data-voice],#voiceBtn,#voice,button[title*="voice" i],button[aria-label*="voice" i]'
    );

    /* Create WhatsApp-style recorder */
    const rec=document.createElement("div");
    rec.className="nexora-voice-recorder";
    rec.innerHTML=`
      <button type="button" class="nexora-record-cancel">✕</button>
      <span class="nexora-record-dot"></span>
      <span class="nexora-record-time">0:00</span>
      <div class="nexora-record-wave">
        ${Array.from({length:32},()=>"<i></i>").join("")}
      </div>
      <button type="button" class="nexora-record-send">➤</button>
    `;
    document.body.appendChild(rec);

    const cancel=rec.querySelector(".nexora-record-cancel");
    const send=rec.querySelector(".nexora-record-send");
    const time=rec.querySelector(".nexora-record-time");

    let stream=null;
    let mediaRecorder=null;
    let chunks=[];
    let timer=null;
    let startedAt=0;

    function stopTracks(){
        if(stream){
            stream.getTracks().forEach(t=>t.stop());
            stream=null;
        }
    }

    function closeRecorder(){
        rec.classList.remove("active");
        clearInterval(timer);
        timer=null;
        stopTracks();
        if(mediaRecorder && mediaRecorder.state!=="inactive"){
            try{mediaRecorder.stop()}catch(e){}
        }
        mediaRecorder=null;
        chunks=[];
    }

    async function startRecorder(){
        if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
            alert("Voice recording is not supported by this browser.");
            return;
        }

        try{
            stream=await navigator.mediaDevices.getUserMedia({audio:true});
            const type=MediaRecorder.isTypeSupported("audio/webm")
                ?"audio/webm":"audio/ogg";

            mediaRecorder=new MediaRecorder(stream,{mimeType:type});
            chunks=[];

            mediaRecorder.ondataavailable=e=>{
                if(e.data && e.data.size) chunks.push(e.data);
            };

            mediaRecorder.onstop=()=>{
                stopTracks();
            };

            mediaRecorder.start();
            rec.classList.add("active");
            startedAt=Date.now();

            timer=setInterval(()=>{
                const sec=Math.floor((Date.now()-startedAt)/1000);
                time.textContent=Math.floor(sec/60)+":"+
                    String(sec%60).padStart(2,"0");
            },250);

        }catch(e){
            alert("Microphone permission is required.");
            stopTracks();
        }
    }

    cancel.onclick=function(){
        closeRecorder();
    };

    send.onclick=function(){
        if(!mediaRecorder || mediaRecorder.state==="inactive"){
            closeRecorder();
            return;
        }

        mediaRecorder.onstop=async function(){
            stopTracks();

            if(!chunks.length){
                closeRecorder();
                return;
            }

            const blob=new Blob(chunks,{type:mediaRecorder.mimeType||"audio/webm"});
            const file=new File(
                [blob],
                "voice_"+Date.now()+".webm",
                {type:blob.type}
            );

            let input=form.querySelector('input[type="file"][name="media"]');

            if(input){
                try{
                    const dt=new DataTransfer();
                    dt.items.add(file);
                    input.files=dt.files;
                    rec.classList.remove("active");
                    form.requestSubmit();
                    return;
                }catch(e){}
            }

            rec.classList.remove("active");
            alert("Voice recording is ready, but this chat form does not expose a media upload field.");
        };

        mediaRecorder.stop();
        clearInterval(timer);
        timer=null;
    };

    /*
     * Replace an existing microphone button while keeping
     * the existing form/upload system intact.
     */
    if(originalVoice){
        originalVoice.addEventListener("click",function(e){
            e.preventDefault();
            e.stopImmediatePropagation();

            if(rec.classList.contains("active")){
                closeRecorder();
            }else{
                startRecorder();
            }
        },true);
    }else{
        const buttons=form.querySelectorAll("button");
        for(const b of buttons){
            const txt=(b.textContent||"").toLowerCase();
            const aria=(b.getAttribute("aria-label")||"").toLowerCase();
            const title=(b.getAttribute("title")||"").toLowerCase();

            if(
                txt.includes("mic") ||
                txt.includes("voice") ||
                txt.includes("🎤") ||
                aria.includes("voice") ||
                aria.includes("microphone") ||
                title.includes("voice") ||
                title.includes("microphone")
            ){
                b.addEventListener("click",function(e){
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    startRecorder();
                },true);
                break;
            }
        }
    }

    /* Keep the latest message visible after opening/sending. */
    function bottom(){
        const boxes=document.querySelectorAll(
            ".chat-messages,.messages,.chat-list,.message-list"
        );
        boxes.forEach(x=>x.scrollTop=x.scrollHeight);
        window.scrollTo(0,document.body.scrollHeight);
    }

    setTimeout(bottom,150);
    setTimeout(bottom,500);
})();
</script>

