{% extends "base.html" %}
{% block content %}

<style>
.comm-page{
    min-height:calc(100vh - 80px);
    background:#000;
    color:#f2fff6;
    padding:12px 10px 100px;
}
.comm-shell{
    max-width:700px;
    margin:0 auto;
}
.comm-header{
    background:#050805;
    border:1px solid #123d20;
    border-radius:18px;
    padding:15px;
    display:flex;
    align-items:center;
    gap:12px;
    box-shadow:0 0 18px rgba(25,230,107,.08);
}
.comm-avatar{
    width:48px;
    height:48px;
    border-radius:50%;
    background:#0d2a17;
    border:2px solid #19e66b;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
}
.comm-title{
    font-size:18px;
    font-weight:800;
}
.comm-status{
    color:#19e66b;
    font-size:12px;
    margin-top:3px;
}
.comm-messages{
    margin-top:12px;
    display:flex;
    flex-direction:column;
    gap:9px;
}
.msg{
    max-width:84%;
    padding:10px 12px;
    border-radius:15px;
    word-break:break-word;
    line-height:1.45;
}
.msg.me{
    align-self:flex-end;
    background:#0b3b1c;
    border:1px solid #166a32;
    border-bottom-right-radius:4px;
}
.msg.manager{
    align-self:flex-start;
    background:#050805;
    border:1px solid #17321f;
    border-bottom-left-radius:4px;
}
.msg-time{
    color:#789080;
    font-size:10px;
    margin-top:5px;
}
.msg a{
    color:#39f27d;
    text-decoration:underline;
}
.msg-media{
    display:block;
    width:100%;
    max-width:300px;
    max-height:360px;
    object-fit:contain;
    border-radius:12px;
    margin-top:7px;
}
.msg-video{
    display:block;
    width:100%;
    max-width:320px;
    max-height:360px;
    border-radius:12px;
    margin-top:7px;
}
.audio-player{
    width:100%;
    max-width:320px;
    margin-top:7px;
}
.link-row{
    display:flex;
    gap:6px;
    margin-top:7px;
}
.copy-link{
    background:#07150b;
    color:#39f27d;
    border:1px solid #185f2e;
    border-radius:8px;
    padding:5px 9px;
    font-size:11px;
}
.chat-box{
    position:fixed;
    left:10px;
    right:10px;
    bottom:65px;
    z-index:20;
    max-width:680px;
    margin:auto;
    background:#020302;
    border:1px solid #174c27;
    border-radius:17px;
    padding:8px;
    box-shadow:0 0 25px rgba(0,0,0,.8);
}
.chat-form{
    display:flex;
    align-items:flex-end;
    gap:6px;
}
.chat-text{
    flex:1;
    min-height:42px;
    max-height:110px;
    resize:none;
    background:#050805;
    color:#fff;
    border:1px solid #174c27;
    border-radius:13px;
    padding:11px;
    outline:none;
}
.chat-btn{
    width:42px;
    height:42px;
    flex:none;
    border-radius:12px;
    border:1px solid #195f2e;
    background:#07150b;
    color:#39f27d;
    font-size:18px;
}
.send-btn{
    background:#19e66b;
    color:#001b09;
    border:0;
    font-weight:900;
}
.file-label{
    width:42px;
    height:42px;
    border-radius:12px;
    border:1px solid #195f2e;
    background:#07150b;
    color:#39f27d;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:19px;
}
#mediaInput{display:none}
.recording{
    border-color:#ff4747!important;
    color:#ff4747!important;
}
.empty-chat{
    text-align:center;
    color:#708078;
    padding:60px 20px;
}
</style>

<div class="comm-page">
<div class="comm-shell">

    <div class="comm-header">
        <div class="comm-avatar">💬</div>
        <div>
            <div class="comm-title">Communication</div>
            <div class="comm-status">● Chat with Customer Service</div>
        </div>
    </div>

    <div class="comm-messages" id="messages">

    {% if messages %}
        {% for m in messages %}
            {% set mine = (m.sender|string|upper == 'USER') %}
            {% set txt = m.message if m.message is defined else '' %}
            {% set media = m.media if m.media is defined else '' %}

            <div class="msg {% if mine %}me{% else %}manager{% endif %}">

                {% if txt %}
                    <div class="message-text">{{ txt }}</div>
                {% endif %}

                {% if media %}
                    {% set ml = media|string|lower %}

                    {% if '.mp4' in ml or '.webm' in ml or '.mov' in ml or '.m4v' in ml %}
                        <video class="msg-video" controls src="{{ media }}"></video>
                    {% elif '.mp3' in ml or '.wav' in ml or '.ogg' in ml or '.m4a' in ml %}
                        <audio class="audio-player" controls src="{{ media }}"></audio>
                    {% else %}
                        <img class="msg-media" src="{{ media }}" alt="Image">
                    {% endif %}

                    <div class="link-row">
                        <button class="copy-link" type="button"
                                onclick="copyLink(this,'{{ media }}')">📋 Copy link</button>
                    </div>
                {% endif %}

                <div class="msg-time">
                    {{ m.created_at if m.created_at is defined else '' }}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="empty-chat">
            <div style="font-size:40px">💬</div>
            <div>No messages yet.</div>
            <div style="font-size:12px;margin-top:5px">Send a message to Customer Service.</div>
        </div>
    {% endif %}

    </div>
</div>
</div>

<div class="chat-box">
<form class="chat-form" method="post" enctype="multipart/form-data"
      action="{{ url_for('support') }}">

    <label class="file-label" for="mediaInput" title="Send image or video">📎</label>
    <input id="mediaInput" name="media" type="file"
           accept="image/*,video/*,audio/*">

    <textarea class="chat-text" name="message" id="messageInput"
              placeholder="Write a message..." rows="1"></textarea>

    <button class="chat-btn" type="button" id="voiceBtn"
            title="Record voice">🎙️</button>

    <button class="chat-btn send-btn" type="submit"
            title="Send">➤</button>
</form>
</div>

<script>
(function(){

const form=document.querySelector(".chat-form");
const input=document.getElementById("messageInput");
const mediaInput=document.getElementById("mediaInput");
const voiceBtn=document.getElementById("voiceBtn");
const sendBtn=form ? form.querySelector(".send-btn") : null;

let recorder=null;
let chunks=[];
let recordedVoice=null;
let recording=false;
let sending=false;

function linkify(root){
    root.querySelectorAll(".message-text").forEach(function(el){
        if(el.dataset.linkified==="1") return;
        el.dataset.linkified="1";

        const text=el.textContent;
        const parts=text.split(/(https?:\/\/[^\s]+|www\.[^\s]+)/gi);
        el.innerHTML="";

        parts.forEach(function(part){
            if(/^https?:\/\//i.test(part) || /^www\./i.test(part)){
                const url=/^www\./i.test(part) ? "https://"+part : part;

                const a=document.createElement("a");
                a.href=url;
                a.target="_blank";
                a.rel="noopener noreferrer";
                a.textContent=part;
                el.appendChild(a);

                const row=document.createElement("div");
                row.className="link-row";

                const b=document.createElement("button");
                b.type="button";
                b.className="copy-link";
                b.textContent="📋 Copy link";
                b.onclick=function(){copyLink(b,url)};

                row.appendChild(b);
                el.appendChild(row);
            }else{
                el.appendChild(document.createTextNode(part));
            }
        });
    });
}

function copyLink(btn,url){
    if(navigator.clipboard){
        navigator.clipboard.writeText(url).then(function(){
            const old=btn.textContent;
            btn.textContent="✓ Copied";
            setTimeout(function(){btn.textContent=old},1200);
        });
    }else{
        prompt("Copy this link:",url);
    }
}

function setSending(state){
    sending=state;

    if(!sendBtn) return;

    sendBtn.disabled=state;
    sendBtn.style.opacity=state ? ".55" : "1";
    sendBtn.textContent=state ? "…" : "➤";
}

function updatePlaceholder(){
    if(recordedVoice){
        input.placeholder="🎙️ Voice message ready — tap Send";
        return;
    }

    if(mediaInput && mediaInput.files && mediaInput.files.length){
        input.placeholder="📎 "+mediaInput.files[0].name+" ready — tap Send";
        return;
    }

    input.placeholder="Write a message...";
}

if(mediaInput){
    mediaInput.addEventListener("change",function(){
        recordedVoice=null;
        updatePlaceholder();
    });
}

if(voiceBtn){
    voiceBtn.addEventListener("click",async function(){

        if(recording && recorder){
            recorder.stop();
            return;
        }

        try{
            const stream=await navigator.mediaDevices.getUserMedia({
                audio:true
            });

            chunks=[];
            recordedVoice=null;

            const options={};

            if(MediaRecorder.isTypeSupported("audio/webm;codecs=opus")){
                options.mimeType="audio/webm;codecs=opus";
            }

            recorder=new MediaRecorder(stream,options);
            recording=true;

            recorder.ondataavailable=function(e){
                if(e.data && e.data.size>0){
                    chunks.push(e.data);
                }
            };

            recorder.onstop=function(){

                recording=false;

                const type=recorder.mimeType || "audio/webm";
                const blob=new Blob(chunks,{type:type});

                if(blob.size===0){
                    alert("No audio was recorded. Please try again.");
                    stream.getTracks().forEach(function(t){t.stop()});
                    voiceBtn.classList.remove("recording");
                    voiceBtn.textContent="🎙️";
                    return;
                }

                recordedVoice=new File(
                    [blob],
                    "voice_message_"+Date.now()+".webm",
                    {type:"audio/webm"}
                );

                stream.getTracks().forEach(function(t){t.stop()});

                voiceBtn.classList.remove("recording");
                voiceBtn.textContent="🎙️";
                updatePlaceholder();
            };

            recorder.onerror=function(){
                recording=false;
                stream.getTracks().forEach(function(t){t.stop()});
                voiceBtn.classList.remove("recording");
                voiceBtn.textContent="🎙️";
                alert("Voice recording failed. Please try again.");
            };

            recorder.start();

            voiceBtn.classList.add("recording");
            voiceBtn.textContent="⏹️";

            input.placeholder="Recording… tap ⏹️ when finished";

        }catch(err){
            alert("Microphone permission is required for voice messages.");
        }
    });
}

if(input){
    input.addEventListener("input",function(){
        this.style.height="42px";
        this.style.height=Math.min(this.scrollHeight,110)+"px";
    });

    input.addEventListener("keydown",function(e){
        if(e.key==="Enter" && !e.shiftKey){
            e.preventDefault();

            if(form && !sending){
                form.requestSubmit();
            }
        }
    });
}

if(form){
    form.addEventListener("submit",function(e){

        if(sending){
            e.preventDefault();
            return;
        }

        if(recording){
            e.preventDefault();
            alert("Stop the recording first, then tap Send.");
            return;
        }

        const text=(input ? input.value : "").trim();
        const selectedFile=
            mediaInput &&
            mediaInput.files &&
            mediaInput.files.length
                ? mediaInput.files[0]
                : null;

        if(!text && !selectedFile && !recordedVoice){
            e.preventDefault();
            return;
        }

        /*
         * If a voice recording exists, put the real Blob/File
         * into the multipart form before normal browser submission.
         */
        if(recordedVoice && mediaInput){
            try{
                const dt=new DataTransfer();
                dt.items.add(recordedVoice);
                mediaInput.files=dt.files;
            }catch(err){
                /*
                 * Some browsers restrict assigning FileList.
                 * In that case use the recorded file through
                 * a hidden input marker and let the server receive
                 * the generated file when supported.
                 */
            }
        }

        setSending(true);

        if(sendBtn){
            sendBtn.title="Sending…";
        }

        /*
         * Do NOT clear the message or attachment here.
         * The browser must finish the multipart upload first.
         */
    });
}

linkify(document);

window.addEventListener("load",function(){
    const box=document.getElementById("messages");
    if(box){
        box.scrollTop=box.scrollHeight;
    }
    updatePlaceholder();
});

})();
</script>

{% endblock %}

