{% extends 'base.html' %}
{% block content %}
<style>
.nx-chat{
  display:flex;
  flex-direction:column;
  height:calc(100vh - 70px);
  min-height:0;
  background:#07110b;
  color:#fff;
  overflow:hidden;
}
.nx-head{
  flex:0 0 auto;
  display:flex;
  align-items:center;
  gap:11px;
  padding:10px 14px;
  background:#0b1710;
  border-bottom:1px solid rgba(57,255,136,.16);
}
.nx-avatar{
  width:42px;height:42px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:#163c27;color:#39ff88;font-size:20px;font-weight:900;
}
.nx-title{font-weight:800;font-size:16px}
.nx-status{font-size:11px;color:#70e99b;margin-top:2px}
.nx-status i{
  display:inline-block;width:7px;height:7px;border-radius:50%;
  background:#39ff88;margin-right:5px;
}
.nx-messages{
  flex:1 1 auto;
  min-height:0;
  overflow-y:auto;
  overflow-x:hidden;
  padding:12px 9px 12px;
  display:flex;
  flex-direction:column;
  gap:5px;
  background:
    radial-gradient(circle at 20% 10%,rgba(57,255,136,.035),transparent 28%),
    #07110b;
}
.nx-row{display:flex;width:100%}
.nx-row.me{justify-content:flex-end}
.nx-row.them{justify-content:flex-start}
.nx-bubble{
  max-width:min(82%,420px);
  padding:7px 9px 5px;
  border-radius:12px;
  background:#14231a;
  box-shadow:0 1px 2px rgba(0,0,0,.25);
  overflow:hidden;
  word-break:break-word;
}
.nx-row.me .nx-bubble{
  background:#123d25;
  border-top-right-radius:4px;
}
.nx-row.them .nx-bubble{
  border-top-left-radius:4px;
}
.nx-text{
  white-space:pre-wrap;
  overflow-wrap:anywhere;
  font-size:15px;
  line-height:1.38;
}
.nx-text a{color:#72f7a8;text-decoration:underline}
.nx-media{
  display:block;
  width:auto;
  max-width:100%;
  max-height:300px;
  border-radius:9px;
  margin-top:3px;
  object-fit:contain;
}
.nx-audio{
  display:block;
  width:245px;
  max-width:100%;
  height:40px;
  margin-top:2px;
}
.nx-time{
  text-align:right;
  color:#8fa797;
  font-size:10px;
  margin-top:3px;
}
.nx-empty{
  margin:auto;
  text-align:center;
  color:#8fa797;
  font-size:13px;
}
.nx-composer{
  flex:0 0 auto;
  display:flex;
  align-items:flex-end;
  gap:6px;
  padding:8px 8px max(8px,env(safe-area-inset-bottom));
  background:#0b1710;
  border-top:1px solid rgba(57,255,136,.15);
}
.nx-file,.nx-icon,.nx-send{
  width:43px;height:43px;min-width:43px;
  border:0;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;
  cursor:pointer;
}
.nx-file,.nx-icon{background:#17261c;color:#b9cdbf}
.nx-send{background:#20d765;color:#06120a;font-weight:900}
.nx-file input{display:none}
.nx-input{
  flex:1;
  min-width:0;
  min-height:43px;
  max-height:110px;
  resize:none;
  border:0;
  outline:0;
  border-radius:22px;
  padding:11px 15px;
  background:#18271d;
  color:#fff;
  font:15px/21px Arial,sans-serif;
}
.nx-input::placeholder{color:#789080}
.nx-recording{
  display:none;
  flex:1;
  min-height:43px;
  align-items:center;
  gap:10px;
  padding:0 12px;
  border-radius:22px;
  background:#18271d;
}
.nx-recording.active{display:flex}
.nx-rec-dot{
  width:10px;height:10px;border-radius:50%;
  background:#ff3b3b;
  animation:nxPulse 1s infinite;
}
.nx-rec-time{font-size:13px;color:#ddd;min-width:38px}
.nx-wave{flex:1;height:28px;display:flex;align-items:center;gap:3px;overflow:hidden}
.nx-wave i{width:3px;border-radius:3px;background:#39ff88;height:8px;animation:nxWave .55s infinite alternate}
.nx-wave i:nth-child(2n){animation-delay:.1s}
.nx-wave i:nth-child(3n){animation-delay:.2s}
@keyframes nxPulse{50%{opacity:.35;transform:scale(.7)}}
@keyframes nxWave{to{height:24px}}
@media(max-width:600px){
  .nx-chat{height:calc(100vh - 60px)}
  .nx-bubble{max-width:88%}
  .nx-audio{width:220px}
}
</style>

<div class="nx-chat">
  <div class="nx-head">
    <div class="nx-avatar">💬</div>
    <div>
      <div class="nx-title">Customer Service</div>
      <div class="nx-status"><i></i>Online</div>
    </div>
  </div>

  <div class="nx-messages" id="nxMessages">
    {% if messages %}
      {% for m in messages %}
        {% set mine = (m.sender|string|upper) != 'ADMIN' %}
        <div class="nx-row {{ 'me' if mine else 'them' }}">
          <div class="nx-bubble">
            {% if m.message %}
              <div class="nx-text">{{ m.message|e }}</div>
            {% endif %}
            {% if m.media %}
              {% set x=m.media|string|lower %}
              {% if 'voice' in x or x.endswith(('.mp3','.wav','.ogg','.m4a','.aac')) %}
                <audio class="nx-audio" controls src="{{ m.media }}"></audio>
              {% elif x.endswith(('.mp4','.webm','.mov','.m4v')) %}
                <video class="nx-media" controls playsinline src="{{ m.media }}"></video>
              {% else %}
                <img class="nx-media" src="{{ m.media }}" alt="Image" loading="lazy">
              {% endif %}
            {% endif %}
            <div class="nx-time">{{ m.created_at if m.created_at is defined else '' }}</div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="nx-empty">
        <div style="font-size:42px">💬</div>
        <div>No messages yet.</div>
        <div style="font-size:12px;margin-top:5px">Send a message to Customer Service.</div>
      </div>
    {% endif %}
  </div>

  <form class="nx-composer" id="nxForm" method="post" enctype="multipart/form-data" action="{{ url_for('support') }}">
    <label class="nx-file" title="Attach">
      📎
      <input id="nxMedia" name="media" type="file" accept="image/*,video/*,audio/*">
    </label>
    <textarea class="nx-input" id="nxInput" name="message" rows="1" placeholder="Message"></textarea>
    <div class="nx-recording" id="nxRecording">
      <span class="nx-rec-dot"></span>
      <span class="nx-rec-time" id="nxRecTime">0:00</span>
      <div class="nx-wave">{% for i in range(28) %}<i></i>{% endfor %}</div>
    </div>
    <button class="nx-icon" id="nxVoice" type="button" title="Voice message">🎙️</button>
    <button class="nx-send" type="submit" title="Send">➤</button>
  </form>
</div>

<script>
(function(){
  const form=document.getElementById("nxForm");
  const box=document.getElementById("nxMessages");
  const input=document.getElementById("nxInput");
  const media=document.getElementById("nxMedia");
  const voice=document.getElementById("nxVoice");
  const recordingBox=document.getElementById("nxRecording");
  const recTime=document.getElementById("nxRecTime");

  let recorder=null,stream=null,chunks=[],voiceFile=null,started=0,timer=null;

  function bottom(){
    if(box) box.scrollTop=box.scrollHeight;
  }

  window.addEventListener("load",()=>setTimeout(bottom,50));

  input.addEventListener("input",function(){
    this.style.height="43px";
    this.style.height=Math.min(this.scrollHeight,110)+"px";
  });

  input.addEventListener("keydown",function(e){
    if(e.key==="Enter" && !e.shiftKey){
      e.preventDefault();
      form.requestSubmit();
    }
  });

  function stopStream(){
    if(stream){
      stream.getTracks().forEach(t=>t.stop());
      stream=null;
    }
  }

  function finishRecording(){
    if(recorder && recorder.state!=="inactive") recorder.stop();
  }

  voice.addEventListener("click",async function(){
    if(recorder && recorder.state==="recording"){
      finishRecording();
      return;
    }

    try{
      stream=await navigator.mediaDevices.getUserMedia({audio:true});
      chunks=[];
      const options=MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
        ? {mimeType:"audio/webm;codecs=opus"} : {};
      recorder=new MediaRecorder(stream,options);

      recorder.ondataavailable=e=>{
        if(e.data && e.data.size) chunks.push(e.data);
      };

      recorder.onstop=()=>{
        clearInterval(timer);
        timer=null;
        const blob=new Blob(chunks,{type:recorder.mimeType||"audio/webm"});
        if(blob.size){
          voiceFile=new File([blob],"voice_message_"+Date.now()+".webm",{type:"audio/webm"});
          input.placeholder="Voice message ready — tap Send";
        }
        stopStream();
        recordingBox.classList.remove("active");
        voice.textContent="🎙️";
        recorder=null;
      };

      recorder.start();
      started=Date.now();
      recordingBox.classList.add("active");
      voice.textContent="⏹";
      timer=setInterval(()=>{
        const s=Math.floor((Date.now()-started)/1000);
        recTime.textContent=Math.floor(s/60)+":"+String(s%60).padStart(2,"0");
      },250);
    }catch(e){
      alert("Microphone permission is required for voice messages.");
    }
  });

  form.addEventListener("submit",function(e){
    if(recorder && recorder.state==="recording"){
      e.preventDefault();
      finishRecording();
      return;
    }

    if(voiceFile && media){
      const dt=new DataTransfer();
      dt.items.add(voiceFile);
      media.files=dt.files;
    }
  });

  media.addEventListener("change",function(){
    if(this.files.length) input.placeholder="Attachment ready — tap Send";
  });
})();
</script>
{% endblock %}
