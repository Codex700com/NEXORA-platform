.green-wave{
    position:absolute;
    left:-8%;
    width:116%;
    height:18vh;
    border:0;
    border-top:1px solid rgba(35,255,115,.34);
    border-bottom:1px solid rgba(35,255,115,.12);
    border-radius:50%;
    box-shadow:
        0 0 16px rgba(35,255,115,.10),
        0 0 34px rgba(35,255,115,.045);
    animation:codexSnakeWave 6s ease-in-out infinite;
    will-change:transform;
}

.green-wave::after{
    content:"";
    position:absolute;
    inset:18% -2%;
    border-top:1px solid rgba(105,255,165,.20);
    border-radius:50%;
}

/* Twelve staggered horizontal snake waves */
.wave-1{top:2%;animation-duration:6.2s;animation-delay:-.4s}
.wave-2{top:10%;animation-duration:7.1s;animation-delay:-2.1s}
.wave-3{top:18%;animation-duration:5.8s;animation-delay:-4.3s}
.wave-4{top:26%;animation-duration:7.8s;animation-delay:-1.2s}
.wave-5{top:34%;animation-duration:6.5s;animation-delay:-3.7s}
.wave-6{top:42%;animation-duration:8.1s;animation-delay:-5.1s}
.wave-7{top:50%;animation-duration:6s;animation-delay:-2.8s}
.wave-8{top:58%;animation-duration:7.4s;animation-delay:-4.7s}
.wave-9{top:66%;animation-duration:5.7s;animation-delay:-1.7s}
.wave-10{top:74%;animation-duration:8.3s;animation-delay:-6s}
.wave-11{top:82%;animation-duration:6.7s;animation-delay:-3.1s}
.wave-12{top:90%;animation-duration:7.6s;animation-delay:-5.5s}

@keyframes codexSnakeWave{
    0%{
        transform:translateX(-5%) translateY(0) rotate(-3deg) scaleY(.88);
    }
    25%{
        transform:translateX(4%) translateY(-13px) rotate(4deg) scaleY(1.05);
    }
    50%{
        transform:translateX(8%) translateY(2px) rotate(-4deg) scaleY(.90);
    }
    75%{
        transform:translateX(-2%) translateY(13px) rotate(4deg) scaleY(1.07);
    }
    100%{
        transform:translateX(-7%) translateY(0) rotate(-3deg) scaleY(.90);
    }
}

/* Manager and Deposit tabs — match the NEXORA Home blue/cyan cards */
a[href="/manager"],
a[href="/deposit"]{
    border:1px solid #008dcc !important;
    background:linear-gradient(145deg,#061a25,#000) !important;
    color:#fff !important;
    box-shadow:0 0 18px rgba(0,190,255,.12);
}

a[href="/manager"]:hover,
a[href="/deposit"]:hover{
    border-color:#00c8ff !important;
    box-shadow:0 0 24px rgba(0,200,255,.22);
}

@media (prefers-reduced-motion:reduce){
    .green-wave{
        animation:none;
    }
}


/* Compact NEXORA interface — smaller typography and tighter rectangular surfaces */
body{
    font-size:13px;
}

.page .box{
    font-size:13px;
}

.title{
    font-size:18px !important;
}

.welcome{
    font-size:14px !important;
}

.phone{
    font-size:11px !important;
}

.muted{
    font-size:11px !important;
}

.value{
    font-size:17px !important;
}

.section{
    padding:10px !important;
    margin-bottom:8px !important;
    border-radius:10px !important;
}

.services{
    gap:7px !important;
}

.services .service{
    min-height:58px !important;
    padding:7px 5px !important;
    border-radius:10px !important;
    font-size:11px !important;
}

.services .icon{
    font-size:17px !important;
    margin-bottom:3px !important;
}

.button,
.action,
button{
    min-height:36px !important;
    padding:7px 12px !important;
    border-radius:8px !important;
    font-size:11px !important;
}

input,
select,
textarea{
    min-height:34px !important;
    padding:7px 9px !important;
    border-radius:8px !important;
    font-size:12px !important;
}

.table{
    font-size:11px !important;
}

.table th,
.table td{
    padding:7px 6px !important;
}

.wallet{
    gap:8px !important;
}

.wallet > div{
    padding:9px !important;
    border-radius:10px !important;
}

.top{
    margin-bottom:9px !important;
}

.vip-circle{
    width:34px !important;
    height:34px !important;
}

.vip-label{
    font-size:9px !important;
}

.linkrow{
    font-size:11px !important;
}

/* Keep the animated background completely behind the interface */
.nexora-green-waves,
.nexora-lightning-bg{
    pointer-events:none !important;
}

.page,
nav{
    position:relative;
    z-index:2;
}

/* Bottom navigation must always stay visible */
.bottom{
    position:fixed !important;
    left:0;
    right:0;
    bottom:0;
    z-index:100 !important;
}

@media (prefers-reduced-motion:reduce){
    .green-wave{
        animation:none !important;
    }
}
