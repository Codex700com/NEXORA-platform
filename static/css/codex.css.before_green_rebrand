/* NEXORA GLOBAL LIVE LIGHTNING BACKGROUND */
body{position:relative}
.nexora-lightning-bg{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:0;
}
.nexora-lightning-bg .bolt{
    position:absolute;
    top:-12%;
    width:3px;
    height:135%;
    opacity:0;
    transform-origin:top center;
    background:linear-gradient(
        to bottom,
        transparent 0%,
        rgba(90,220,255,.95) 18%,
        #fff 48%,
        rgba(0,190,255,.9) 72%,
        transparent 100%
    );
    filter:drop-shadow(0 0 4px #00baff) drop-shadow(0 0 12px rgba(0,190,255,.85));
    clip-path:polygon(
        50% 0%,58% 8%,42% 17%,63% 25%,45% 34%,
        67% 43%,43% 52%,60% 62%,39% 72%,57% 82%,
        44% 91%,50% 100%
    );
    animation:codexLightning 6s infinite;
}
.nexora-lightning-bg .bolt::before,
.nexora-lightning-bg .bolt::after{
    content:"";
    position:absolute;
    width:2px;
    height:48%;
    top:20%;
    background:linear-gradient(to bottom,transparent,#fff,rgba(0,190,255,.85),transparent);
    filter:drop-shadow(0 0 5px #00baff);
}
.nexora-lightning-bg .bolt::before{
    left:-18px;
    transform:rotate(31deg);
}
.nexora-lightning-bg .bolt::after{
    right:-20px;
    top:43%;
    transform:rotate(-28deg);
}
.nexora-lightning-bg .bolt:nth-of-type(1){left:5%;transform:rotate(-9deg);animation-delay:-.8s;animation-duration:5.8s}
.nexora-lightning-bg .bolt:nth-of-type(2){left:15%;transform:rotate(7deg);animation-delay:-4.1s;animation-duration:7.2s}
.nexora-lightning-bg .bolt:nth-of-type(3){left:27%;transform:rotate(-5deg);animation-delay:-2.4s;animation-duration:6.4s}
.nexora-lightning-bg .bolt:nth-of-type(4){left:39%;transform:rotate(8deg);animation-delay:-5.3s;animation-duration:8s}
.nexora-lightning-bg .bolt:nth-of-type(5){left:51%;transform:rotate(-7deg);animation-delay:-1.7s;animation-duration:6.9s}
.nexora-lightning-bg .bolt:nth-of-type(6){left:63%;transform:rotate(6deg);animation-delay:-6s;animation-duration:7.6s}
.nexora-lightning-bg .bolt:nth-of-type(7){left:75%;transform:rotate(-8deg);animation-delay:-3.2s;animation-duration:5.5s}
.nexora-lightning-bg .bolt:nth-of-type(8){left:87%;transform:rotate(7deg);animation-delay:-4.8s;animation-duration:6.7s}
.nexora-lightning-bg .flash{
    position:absolute;
    inset:0;
    background:rgba(80,210,255,.055);
    opacity:0;
    animation:codexSkyFlash 4.8s infinite;
}
.nexora-lightning-bg .flash:nth-child(10){animation-delay:-2.1s}
.nexora-lightning-bg .flash:nth-child(11){animation-delay:-3.7s}

@keyframes codexLightning{
    0%,88%,100%{opacity:0}
    89%{opacity:.15}
    89.4%{opacity:1}
    89.8%{opacity:.12}
    90.2%{opacity:.9}
    90.7%{opacity:.08}
    91.4%{opacity:.65}
    92.5%{opacity:0}
}
@keyframes codexSkyFlash{
    0%,88%,100%{opacity:0}
    89.3%{opacity:.18}
    89.8%{opacity:0}
    90.3%{opacity:.12}
    91%{opacity:0}
}

/* Keep every real NEXORA interface layer above the lightning. */
.page{position:relative;z-index:2}
.bottom{z-index:100}
.announcement-backdrop{z-index:1000}

@media(prefers-reduced-motion:reduce){
    .nexora-lightning-bg .bolt,
    .nexora-lightning-bg .flash{animation:none}
}


