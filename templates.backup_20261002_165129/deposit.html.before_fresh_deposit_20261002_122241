<div>Status</div>
<div class="agent-number">PENDING ADMIN APPROVAL</div>
</div>

<div class="agent">
<div>Amount</div>
<div class="agent-number">UGX {{ "{:,.0f}".format(deposit.amount) }}</div>
</div>

<div class="agent">
<div>Payment method</div>
<div class="agent-number">{{deposit.payment_method}}</div>
</div>

<div class="agent">
<div>Transaction ID</div>
<div class="agent-number" style="font-size:17px;word-break:break-all">{{deposit.proof}}</div>
</div>

<div class="agent">
<div>Number that paid</div>
<div class="agent-number">{{deposit.payer_number}}</div>
</div>

<div class="note">
Your payment request has been sent to the administrator for verification.
Your wallet will only be credited after approval.
</div>

{% endif %}

</div>
</div>

</div></div>

<script id="nexora-amount-box-script">
document.addEventListener("DOMContentLoaded",function(){

  const input =
    document.querySelector('input[name="amount"]') ||
    document.querySelector('input[id*="amount"]') ||
    document.querySelector('input[placeholder*="Amount"]');

  if(!input) return;

  const title=document.createElement("div");
  title.className="amount-box-title";
  title.textContent="SELECT AMOUNT";

  const boxes=document.createElement("div");
  boxes.className="amount-boxes";

  const amounts=[
    ["20K",20000],
    ["50K",50000],
    ["100K",100000],
    ["250K",250000],
    ["500K",500000],
    ["1M",1000000],
    ["2M",2000000],
    ["3M",3000000],
    ["5M",5000000]
  ];

  amounts.forEach(function(item){
    const b=document.createElement("button");
    b.type="button";
    b.className="amount-box";
    b.textContent=item[0];

    b.addEventListener("click",function(){
      input.value=item[1];
      input.dispatchEvent(new Event("input",{bubbles:true}));
      input.dispatchEvent(new Event("change",{bubbles:true}));

      document.querySelectorAll(".amount-box").forEach(function(x){
        x.classList.remove("selected");
      });
      b.classList.add("selected");
    });

    boxes.appendChild(b);
  });

  input.parentNode.insertBefore(title,input);
  input.parentNode.insertBefore(boxes,input);

  /* Hide only the visible payment-agent heading/label.
     The actual payment information and existing backend remain untouched. */
  document.querySelectorAll("h1,h2,h3,h4,.agent-title,.payment-agent-title").forEach(function(el){
    const t=(el.textContent||"").trim().toLowerCase();
    if(t.includes("payment agent")){
      el.style.display="none";
    }
  });

});
</script>

<script id="remove-payment-agent-heading">
document.addEventListener("DOMContentLoaded",function(){
  document.querySelectorAll("h1,h2,h3,h4,h5,h6,p,div,span,label").forEach(function(el){
    const text=(el.textContent||"").trim().toLowerCase();
    if(
      text.includes("nexora payment agent") ||
      text.includes("payment agent 626") ||
      text === "payment agent"
    ){
      el.style.display="none";
    }
  });
});
</script>

<script id="remove-agent-space">
document.addEventListener("DOMContentLoaded",function(){

  document.querySelectorAll("*").forEach(function(el){
    const text=(el.textContent||"").trim().toLowerCase();

    if(
      text.includes("nexora payment agent") ||
      text.includes("payment agent 626") ||
      text === "payment agent 626"
    ){
      let box=el;

      /* Find the nearest visual container */
      for(let i=0;i<4 && box.parentElement;i++){
        if(
          box.parentElement.classList.contains("agent") ||
          box.parentElement.classList.contains("deposit-modal")
        ){
          break;
        }
        box=box.parentElement;
      }

      /* Remove only the visible agent information block */
      if(box && !box.classList.contains("deposit-modal")){
        box.remove();
      }else{
        el.style.display="none";
      }
    }
  });

});
</script>

<script id="final-agent-space-fix">
document.addEventListener("DOMContentLoaded",function(){

  document.querySelectorAll(".agent").forEach(function(el){
    const text=(el.textContent||"").trim().toLowerCase();

    if(
      text.includes("payment agent") ||
      text.includes("626") ||
      text.includes("nexora")
    ){
      el.remove();
    }
  });

  /* Remove empty containers left behind by the removed agent block */
  document.querySelectorAll("div").forEach(function(el){
    if(
      el.children.length===0 &&
      el.textContent.trim()==="" &&
      getComputedStyle(el).height !== "0px"
    ){
      const rect=el.getBoundingClientRect();
      if(rect.height>10 && rect.width>100){
        el.style.display="none";
      }
    }
  });

});
</script>
{% endblock %}
