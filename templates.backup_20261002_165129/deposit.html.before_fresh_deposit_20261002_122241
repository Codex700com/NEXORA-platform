{% extends 'base.html' %}
{% block content %}
<style id="nexora-amount-boxes">
/* Remove visible payment-agent heading only */
.deposit-agent-heading,
.payment-agent-heading,
.payment-agent-title,
.agent-title,
.agent-heading{
  display:none!important;
}

.deposit-simple-title{
  color:#f2fff5;
  font-size:24px;
  font-weight:900;
  margin:0 0 6px;
}
.deposit-simple-sub{
  color:#789382;
  font-size:10px;
  line-height:1.5;
  margin-bottom:17px;
}
.amount-box-title{
  color:#789382;
  font-size:10px;
  font-weight:800;
  margin:0 0 9px;
}
.amount-boxes{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:15px;
}
.amount-box{
  min-height:48px;
  border-radius:11px;
  border:1px solid #154b2c;
  background:#030806;
  color:#b9d9c4;
  font-size:11px;
  font-weight:900;
  cursor:pointer;
}
.amount-box:active,
.amount-box.selected{
  background:#18d66b;
  border-color:#18d66b;
  color:#031008;
}
.deposit-payment-agent-title{
  display:none!important;
}
</style>

<style id="nexora-simple-deposit">
/* SIMPLE NEXORA DEPOSIT DESIGN */
body{
  background:#030806!important;
}
.deposit-modal{
  background:#07130b!important;
  border:1px solid #154b2c!important;
  border-radius:18px!important;
  box-shadow:none!important;
  padding:18px!important;
}
.deposit-modal h1{
  font-size:24px!important;
  color:#f2fff5!important;
  margin-bottom:6px!important;
}
.deposit-modal h2,
.deposit-modal h3{
  color:#f2fff5!important;
}
.deposit-input{
  width:100%!important;
  box-sizing:border-box!important;
  background:#030806!important;
  color:#fff!important;
  border:1px solid #123d25!important;
  border-radius:11px!important;
  padding:13px!important;
}
.deposit-input:focus{
  border-color:#18d66b!important;
  outline:none!important;
}
.deposit-btn{
  width:100%!important;
  background:#18d66b!important;
  color:#031008!important;
  border:0!important;
  border-radius:11px!important;
  padding:13px!important;
  font-weight:900!important;
}
.agent{
  background:#030806!important;
  border:1px solid #154b2c!important;
  border-radius:14px!important;
  padding:14px!important;
}
.deposit-page-theme{
  color:#e8f5ed!important;
}
.deposit-page-theme label{
  color:#789382!important;
}
.deposit-page-theme .muted{
  color:#708a79!important;
}
.deposit-page-theme .success{
  color:#39ff88!important;
}
.deposit-page-theme .error{
  color:#ff6969!important;
}
</style>

<style>
.deposit-page-theme{color:#e8f5ed}
.deposit-modal{
background:linear-gradient(145deg,#091a0f,#040906)!important;
border:1px solid #165a34!important;
border-radius:24px!important;
box-shadow:0 15px 35px rgba(0,0,0,.4)!important;
}
.deposit-modal h1,.deposit-modal h2,.deposit-modal h3{color:#f2fff5}
.deposit-input{
background:#030806!important;
color:#fff!important;
border:1px solid #123d25!important;
border-radius:13px!important;
}
.deposit-input:focus{
border-color:#18d66b!important;
box-shadow:0 0 0 1px rgba(24,214,107,.15);
}
.deposit-btn{
background:#18d66b!important;
color:#031008!important;
border-radius:13px!important;
box-shadow:0 9px 22px rgba(24,214,107,.18);
}
.agent{
background:#061009!important;
border:1px solid #164d2c!important;
border-radius:17px!important;
}
.deposit-page-theme label{color:#83a58f}
.deposit-page-theme .muted{color:#708a79}
.deposit-page-theme .success{color:#39ff88!important}
.deposit-page-theme .error{color:#ff6969!important}
</style>


<style>
.deposit-wrap{max-width:520px;margin:20px auto}
.deposit-modal{background:#071426;border:1px solid #18d66b;border-radius:18px;padding:24px;box-shadow:0 12px 35px rgba(0,0,0,.35)}
.deposit-title{font-size:22px;font-weight:800;margin-bottom:8px}
.deposit-sub{opacity:.78;margin-bottom:20px;line-height:1.55}
.deposit-input{width:100%;box-sizing:border-box;padding:14px;border-radius:12px;border:1px solid #29415f;background:#030b18;color:#fff;font-size:17px;margin-bottom:14px}
.deposit-btn{width:100%;border:0;border-radius:12px;padding:14px;background:#18d66b;color:white;font-weight:800;font-size:16px;margin-top:8px}
.method-btn{margin-bottom:10px}
.error{color:#ff6969;margin-bottom:12px;font-weight:700}
.success{color:#35d07f;font-weight:800}
.agent{padding:16px;border-radius:14px;background:#030b18;border:1px solid #29415f;margin:14px 0}
.agent-number{font-size:21px;font-weight:900;margin-top:5px}
.countdown{font-size:28px;font-weight:900;text-align:center;margin:18px 0}
.note{font-size:13px;opacity:.7;line-height:1.5}
</style>

<div class="deposit-wrap">
<div class="deposit-page-theme"><div class="deposit-modal">

{% if stage=="amount" %}

<div class="deposit-title">NEXORA PAYMENT AGENT 626</div>
<div class="deposit-sub">Enter the amount you want to deposit. Minimum required deposit: <b>UGX 20,000</b>.</div>

{% if error %}<div class="error">{{error}}</div>{% endif %}

<form method="post">
<input type="hidden" name="action" value="start">
<input class="deposit-input" name="amount" type="number" min="20000" step="1" placeholder="Amount (UGX)" required>
<button class="deposit-btn" type="submit">Continue</button>
</form>

{% elif stage=="method" %}

<div class="deposit-title">Choose Airtel or MTN</div>
<div class="deposit-sub">Choose the mobile-money network you will use to make the payment.</div>

{% if error %}<div class="error">{{error}}</div>{% endif %}

<form method="post">
<input type="hidden" name="action" value="method">
<button class="deposit-btn method-btn" name="method" value="Airtel" type="submit">Airtel</button>
<button class="deposit-btn method-btn" name="method" value="MTN" type="submit">MTN</button>
</form>

{% elif stage=="agent" %}

<div class="deposit-title">Payment instructions</div>
<div class="deposit-sub">Send the exact amount below to the payment agent.</div>

<div class="agent">
<div>Send money to</div>
<div class="agent-number">0757837051</div>
<div style="margin-top:5px;font-weight:800">Mary Namara</div>
</div>

<div class="agent">
<div>Payment method</div>
<div class="agent-number">{{deposit.payment_method}}</div>
</div>

<div class="agent">
<div>Amount</div>
<div class="agent-number">UGX {{ "{:,.0f}".format(deposit.amount) }}</div>
</div>

<div id="redirectBox" class="note" style="text-align:center;padding:15px">
Preparing payment instructions...
</div>

<div id="agentBox" style="display:none">
<div class="countdown" id="countdown">30:00</div>

<div class="note">
You have 30 minutes to complete this payment. You may leave this page to send the money.
When you return to Deposit before the timer expires, you will be taken back to the payment-proof popup.
</div>

<button class="deposit-btn" type="button" onclick="location.reload()">I have made the payment</button>
</div>

<script>
setTimeout(function(){
    document.getElementById('redirectBox').style.display='none';
    document.getElementById('agentBox').style.display='block';
},800);

const expiry={{ deposit.expires_at|tojson }};

function updateTimer(){
    const left=Math.max(0,Date.parse(expiry)-Date.now());

    if(left<=0){
        document.getElementById('countdown').textContent='EXPIRED';
        setTimeout(function(){ location.href="{{ url_for('deposit') }}"; },700);
        return;
    }

    const total=Math.floor(left/1000);
    const m=Math.floor(total/60);
    const sec=total%60;

    document.getElementById('countdown').textContent=
        String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
}
updateTimer();
setInterval(updateTimer,1000);
</script>

{% elif stage=="proof" %}

<div class="deposit-title">Confirm Payment</div>
<div class="deposit-sub">
Enter the details of the payment you made.
</div>

<div class="agent">
<div>Amount</div>
<div class="agent-number">UGX {{ "{:,.0f}".format(deposit.amount) }}</div>
</div>

<div class="agent">
<div>Payment method</div>
<div class="agent-number">{{deposit.payment_method}}</div>
</div>

<div class="agent">
<div>Payment agent</div>
<div class="agent-number">0757837051</div>
<div style="margin-top:5px">Mary Namara</div>
</div>

<div id="countdown" class="countdown">30:00</div>

{% if error %}<div class="error">{{error}}</div>{% endif %}

<form method="post" id="proofForm">
<input type="hidden" name="action" value="proof">

<label>Transaction ID</label>
<input class="deposit-input" name="proof" type="text" placeholder="Enter transaction ID" required>

<label>Number that made the payment</label>
<input class="deposit-input" name="payer_number" type="tel" placeholder="Enter the number that paid" required>

<button class="deposit-btn" type="submit">Verify Payment</button>
</form>

<div class="note">
The 30-minute expiry is controlled by the server. If it expires before submission,
this deposit attempt closes and the next Deposit starts again from the amount popup.
</div>

<script>
const expiry={{ deposit.expires_at|tojson }};

function updateTimer(){
    const left=Math.max(0,Date.parse(expiry)-Date.now());

    if(left<=0){
        document.getElementById('countdown').textContent='EXPIRED';
        document.getElementById('proofForm').style.display='none';
        setTimeout(function(){ location.href="{{ url_for('deposit') }}"; },700);
        return;
    }

    const total=Math.floor(left/1000);
    const m=Math.floor(total/60);
    const sec=total%60;

    document.getElementById('countdown').textContent=
        String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
}

updateTimer();
setInterval(updateTimer,1000);
</script>

{% elif stage=="review" %}

<div class="deposit-title success">Payment submitted successfully</div>

<div class="deposit-sub">
<b>Payment submitted successfully.</b><br>
<b>Payment request submitted successfully.</b><br>
Your deposit is now <b>pending admin approval</b>.
</div>

