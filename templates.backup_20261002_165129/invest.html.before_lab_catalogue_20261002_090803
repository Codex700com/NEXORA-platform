{% extends 'base.html' %}{% block content %}

<style>
.nx-lab-shell{
  padding:10px 2px 90px;
  font-family:Arial,sans-serif;
}
.nx-lab-head{
  padding:8px 4px 18px;
}
.nx-lab-kicker{
  font:8px monospace;
  letter-spacing:2px;
  color:#39ff88;
  margin-bottom:7px;
}
.nx-lab-title{
  margin:0;
  color:#fff;
  font-size:25px;
  font-weight:800;
  letter-spacing:.5px;
}
.nx-lab-sub{
  margin:6px 0 0;
  color:#718087;
  font:9px monospace;
  letter-spacing:1px;
}
.nx-machine-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:13px;
}
.nx-machine-card{
  position:relative;
  overflow:hidden;
  border:1px solid rgba(57,255,136,.18);
  border-radius:20px;
  background:linear-gradient(145deg,rgba(10,24,25,.98),rgba(2,8,11,.98));
  box-shadow:0 8px 28px rgba(0,0,0,.35);
}
.nx-machine-card:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(120deg,transparent,rgba(57,255,136,.04),transparent);
}
.nx-machine-img{
  width:100%;
  height:145px;
  object-fit:cover;
  display:block;
  border-bottom:1px solid rgba(57,255,136,.13);
}
.nx-machine-body{
  padding:15px;
}
.nx-machine-code{
  color:#39ff88;
  font:9px monospace;
  letter-spacing:2px;
}
.nx-machine-name{
  margin:5px 0 12px;
  color:#fff;
  font-size:19px;
  font-weight:800;
}
.nx-machine-stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.nx-stat{
  padding:10px;
  border-radius:12px;
  background:rgba(255,255,255,.025);
  border:1px solid rgba(255,255,255,.06);
}
.nx-stat small{
  display:block;
  color:#65747b;
  font:7px monospace;
  letter-spacing:1px;
  margin-bottom:4px;
}
.nx-stat b{
  color:#eafff1;
  font-size:12px;
}
.nx-machine-action{
  display:block;
  margin-top:13px;
  padding:12px;
  text-align:center;
  text-decoration:none;
  border-radius:12px;
  color:#001b0b;
  background:#39ff88;
  font-weight:800;
  font-size:11px;
  letter-spacing:1px;
}
.nx-note{
  margin:12px 2px 0;
  color:#536168;
  font:8px monospace;
  line-height:1.5;
}
</style>

<div class="nx-lab-shell">
<div class="ai-head">
  <div>
    <div class="title ai-title">NEXORA</div>
    <div class="ai-subtitle">SMARTER MINING • BIGGER REWARDS</div>
  </div>
  <div class="live-pill"><span></span> CATALOGUE</div>
</div>

<section class="ai-live-hero">
  <img src="/static/ai_mining_scene.png" alt="AI mining robots and excavators">
  <div class="scanline"></div>
  <div class="wave-layer" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="live-caption"><b>AI MINING ROBOTS</b><small>Robots • Excavators • Control Center</small></div>
</section>

<section class="live-panel">
  <div class="section-heading"><span class="pulse-dot"></span><b>Live Products Activity</b><span class="online">PRODUCTS AVAILABLE</span></div>
  <div class="live-feeds">
    <div class="live-feed">
      <div class="feed-image excavator-feed"></div>
      <div class="feed-label">⛏ Excavators <span>● MOVING</span></div>
    </div>
    <div class="live-feed">
      <div class="feed-image robot-feed"></div>
      <div class="feed-label">🤖 Products Robots <span>● ACTIVE</span></div>
    </div>
    <div class="live-feed">
      <div class="feed-image computer-feed"></div>
      <div class="feed-label">▣ Robot Control <span>● ONLINE</span></div>
    </div>
  </div>
</section>

<a class="button" href="/ai-mining" style="display:block;text-align:center;margin-bottom:16px">OPEN AI ROBOT & MINING DIMENSION</a>
<section class="machine-section">
  <div class="section-heading"><b>AI Machines</b><span class="muted">Activate a machine</span></div>
  <div class="grid">
    {% for code,p in plans.items() %}
    <div class="card machine-card">
      <div class="machine-photo"><img src="/static/ai_mining_scene.png" alt="{{code}} AI machine"></div>
      <h2>{{code}}</h2><div class="muted">{{p.series}}</div>
      <div>Amount required</div><div class="value">UGX {{'{:,.0f}'.format(p.price)}}</div>
      <p>Duration: {{p.days}} days<br>Daily income: UGX {{'{:,.0f}'.format(p.daily)}}<br>Total income: UGX {{'{:,.0f}'.format(p.total)}}</p>
      <a class="button" style="display:block;text-align:center" href="/product?p={{code}}">Activate Machine</a>
    </div>
    {% endfor %}
  </div>
</section>

<section class="how-ai">
  <h2>How AI Products Works</h2>
  <div class="how-row"><b>01</b><span>Choose a machine</span><b>02</b><span>AI robots operate</span><b>03</b><span>Income is recorded</span></div>
</section>
</div>
{% endblock %}
